# Every text file is checked out with LF, on every host (#356, ADR 0001): Git for Windows sets
# core.autocrlf=true system-wide, and bash cannot run a CRLF script ($'\r': command not found).
* text=auto eol=lf
# …but for cmd batch files, which cmd.exe reads CRLF (test/smoke/fleet_smoke.cmd, #357).
*.cmd text eol=crlf
# bench/ENGINE_COMMIT carries the commit in a `git archive` extraction (the release gate has no .git, #653).
bench/ENGINE_COMMIT export-subst
