# Harness per-project config — written by 'harness init'.
# Lines use := so a pre-set environment variable overrides this file.
: "${HARNESS_CLI:=claude}"
: "${HARNESS_MODE:=prd}"
: "${HARNESS_OWNER:=VocanicZ}"
: "${HARNESS_REPO:=VocanicZ/bench-20261110t202630z-harness-r02}"
: "${HARNESS_UNIT:=bench-20261110t202630z-harness-r02}"
: "${HARNESS_SPEC:=}"
: "${HARNESS_AUTONOMOUS:=true}"
: "${HARNESS_SESS_PREFIX:=bnd65b0}"
: "${HARNESS_POOL:=1}"
: "${HARNESS_POLL:=300}"
: "${HARNESS_PRIORITY_POLL:=60}"
: "${HARNESS_LABEL_READY:=ready-for-agent}"
: "${HARNESS_LABEL_PRD:=prd}"
: "${HARNESS_LABEL_WORKING:=agent-working}"
: "${HARNESS_LABEL_BLOCKED:=agent-blocked}"
: "${HARNESS_LABEL_REVIEWED:=reviewed}"
: "${HARNESS_LABEL_COORD:=coordination}"
: "${HARNESS_LABEL_PAUSED:=agent-paused}"
: "${HARNESS_LABEL_BUG:=bug}"
: "${HARNESS_LABEL_BUG_TRIAGED:=bug-triaged}"
: "${HARNESS_LABEL_HITL:=hitl}"
: "${HARNESS_AUTHOR_ALLOWLIST:=}"
: "${HARNESS_SECURITY_AUDIT:=0}"
: "${HARNESS_MODEL_MANAGER:=opus}"
: "${HARNESS_EFFORT_MANAGER:=high}"
: "${HARNESS_MODEL_IMPLEMENTER:=sonnet}"
: "${HARNESS_EFFORT_IMPLEMENTER:=high}"
: "${HARNESS_USE_POLLER:=0}"
: "${HARNESS_SESSION_BACKEND:=tmux}"
