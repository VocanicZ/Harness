# per-project local state (written by `harness init` / runtime)
/config
/targets.tsv
/run/
/worktrees/
/checkouts/
/prompts/*.local.md
__pycache__/
*.pyc
/graphify-out/
.harness/
.claude/

# rtdd run artifacts (the map itself IS committed; these are per-run)
/.coverage
/.rtdd/junit.xml
# meta.json is per-run state (cycle counter, drift digest) — it changes on every run and has
# no union merge driver, unlike the map. The map is the artifact worth committing.
/.rtdd/meta.json
