#!/usr/bin/env bash
set -uo pipefail
# ENGINE_DIR — the engine install (this file lives in <engine>/bin/). Resolved via realpath of the
# entrypoint's OWN path first, so a PATH symlink (e.g. ~/.local/bin/harness → ~/.harness/engine/
# bin/harness) resolves to the REAL engine, not the symlink's dir (#53, PRD #52).
# STATE_DIR — the per-project .harness/ (config + runtime). It is no longer tied to ENGINE_DIR:
# the engine is one shared host install, project state lives in the project (#55). It is resolved
# per-command below — a pre-set env STATE_DIR always wins; otherwise it is DISCOVERED by walking UP
# from cwd for a .harness/config (like git finds .git), so any subcommand works from a subdirectory.
_self="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
ENGINE_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
export ENGINE_DIR
# HARNESS_ENGINE_LINK — the STABLE path to this engine, for anything long-lived that must follow an
# update (#281): the supervise/web units' ExecStart, the /harness skills source. $HARNESS_HOME/engine
# when it resolves to this ENGINE_DIR (a release behind the engine link, or today's git checkout),
# else ENGINE_DIR itself (a dev clone or test sandbox keeps naming itself). ENGINE_DIR stays the
# concrete release, so a launched worker keeps reading its own release after the link flips.
_link="${HARNESS_HOME:-$HOME/.harness}/engine"
# Compared in MSYS form (#491): on Windows `realpath` keeps the spelling it is given, so a HARNESS_HOME written C:/x (a Windows
# environment variable, a test isolation) resolves to C:/x/releases/v while ENGINE_DIR is /c/x/releases/v, and the link was
# never taken: the supervise and web tasks then pinned one release's path and an update never moved them.
_pn(){ cygpath -u "$1" 2>/dev/null || printf '%s' "$1"; }
if [[ "$(_pn "$(realpath "$_link" 2>/dev/null)")" == "$(_pn "$ENGINE_DIR")" ]]; then HARNESS_ENGINE_LINK="$_link"; else HARNESS_ENGINE_LINK="$ENGINE_DIR"; fi
export HARNESS_ENGINE_LINK
# #355: on Windows, the path variables native programs read (python.exe for stats/fleetview/forecast,
# exec'd straight from here) are exported in mixed form (C:/…); a no-op elsewhere.
# A stripped engine copy (a test fixture) may lack portable.sh: its paths then stay as they are.
if [[ -f "$ENGINE_DIR/scripts/portable.sh" ]]; then source "$ENGINE_DIR/scripts/portable.sh"; else export_native_paths(){ :; }; is_windows(){ return 1; }; fi
# #356: on Windows `python3` on PATH is the Microsoft Store stub; install.sh's shim in $HARNESS_HOME/bin
# runs the real interpreter, so that directory goes first for this command and everything it starts.
# In MSYS form (`cygpath -u`): PATH cannot hold a C:/… entry, the form an inherited HARNESS_HOME may have.
if is_windows 2>/dev/null; then
  _shim="$(cygpath -u "${HARNESS_HOME:-$HOME/.harness}" 2>/dev/null || printf '%s' "${HARNESS_HOME:-$HOME/.harness}")/bin"
  [[ -x "$_shim/python3" && ":$PATH:" != *":$_shim:"* ]] && export PATH="$_shim:$PATH"
fi
export_native_paths

# discover_state_dir — walk UP from cwd for a .harness/config; echo that .harness dir, or fail (1).
discover_state_dir(){
  local d; d="$(pwd -P)"
  while :; do
    [[ -f "$d/.harness/config" ]] && { printf '%s\n' "$d/.harness"; return 0; }
    [[ "$d" == / ]] && return 1
    d="$(dirname "$d")"
  done
}
# canon — normalise a path for comparison (trailing slash, ./, symlinks). -m so a not-yet-created
# path still normalises; every fallback degrades to the literal string rather than empty.
# On Windows (#921) realpath keeps the spelling it is given, and a path can arrive as C:/x or /c/x: both go to the /c/x form (cygpath -u) so
# the same directory compares equal. cygpath exists only under MSYS/Cygwin.
canon(){ local c; c="$(realpath -m "$1" 2>/dev/null || readlink -f "$1" 2>/dev/null || printf '%s\n' "$1")"
  if command -v cygpath >/dev/null 2>&1; then cygpath -u "$c" 2>/dev/null || printf '%s\n' "$c"; else printf '%s\n' "$c"; fi; }
# assert_state_dir_deliberate — refuse an INHERITED STATE_DIR that points at ANOTHER project (#168).
#
# A Claude session launched inside a fleet inherits that fleet's exported STATE_DIR, so `cd`-ing to
# a different project and running a project command operated on the fleet you came FROM, silently:
# on 2026-08-12 a `harness stop` stopped the wrong project's fleet and reported success. The env var
# cannot express DELIBERATE vs INHERITED — hence the explicit --state-dir flag as the escape hatch.
#
#   deliberate (--state-dir / HARNESS_STATE_DIR_OK=1) → always allow
#   nothing discoverable from cwd                     → allow (the vendored / out-of-tree case, #53)
#   discovery agrees, or cwd is inside the state tree → allow, silently (workers export it legitimately)
#   discovery DISAGREES                               → refuse, non-zero, naming both paths
assert_state_dir_deliberate(){
  [[ -n "${STATE_DIR:-}" ]] || return 0
  [[ "$STATE_DIR_EXPLICIT" == 1 || -n "${HARNESS_STATE_DIR_OK:-}" ]] && return 0
  local disc; disc="$(discover_state_dir 2>/dev/null)" || return 0
  local have want; have="$(canon "$STATE_DIR")"; want="$(canon "$disc")"
  # A worker's cwd is a worktree UNDER the fleet's own state dir, and that worktree may itself carry
  # a .harness/config (self-hosting) — discovery finds the inner one, which is still this fleet.
  [[ "$have" == "$want" || "$want" == "$have"/* ]] && return 0
  cat >&2 <<EOF
harness: STATE_DIR is set to $have (inherited from the environment),
  but this directory belongs to $want.
  Refusing to act on a project you are not in.
  Run with --state-dir <path> to be explicit, or 'unset STATE_DIR' to use this directory.
EOF
  exit 4
}
# require_state_dir — set+export STATE_DIR for commands that act on a project. A pre-set STATE_DIR
# wins (env override / vendored layout) unless it disagrees with cwd's project — see
# assert_state_dir_deliberate; else discover it. Outside any Harness project: a clear, non-zero
# error here — not a cryptic path failure deep in lib.sh.
require_state_dir(){
  [[ -n "${STATE_DIR:-}" ]] && { assert_state_dir_deliberate; export STATE_DIR; return 0; }
  if STATE_DIR="$(discover_state_dir)"; then export STATE_DIR; return 0; fi
  cat >&2 <<EOF
harness: not inside a Harness project — no .harness/config found here or in any parent directory.
  Run 'harness init' in your project's root to create one, or cd into an existing Harness project.
EOF
  exit 3
}
# try_state_dir — best-effort STATE_DIR for engine-level commands (e.g. update) that work anywhere
# but use project state when present. Never errors.
# Its callers exec python3 (forecast) or update.sh straight from here, so the STATE_DIR it exports is
# put in native form on Windows (#355; lib.sh does that for the project commands).
try_state_dir(){ [[ -n "${STATE_DIR:-}" ]] || STATE_DIR="$(discover_state_dir 2>/dev/null)" || true; export STATE_DIR
  export_native_paths STATE_DIR; }
# print_version — this engine's release (#277). A release archive carries VERSION: line 1 the tag,
# line 2 the full commit it was built from. A git checkout of the engine has none, so it reports
# `git describe` marked as a dev build — but only when ENGINE_DIR is that repo's own top level, so an
# engine merely nested in some other repo (a dotfiles $HOME) never borrows its describe. Never fails.
print_version(){
  local tag sha top out
  if [[ -r "$ENGINE_DIR/VERSION" ]]; then
    tag="$(sed -n 1p "$ENGINE_DIR/VERSION")"; sha="$(sed -n 2p "$ENGINE_DIR/VERSION" | cut -c1-7)"
    out="harness $tag ($sha)"
  elif top="$(git -C "$ENGINE_DIR" rev-parse --show-toplevel 2>/dev/null)" \
       && [[ "$(cd "$top" && pwd -P)" == "$(cd "$ENGINE_DIR" && pwd -P)" ]]; then
    out="harness $(git -C "$ENGINE_DIR" describe --tags --always --dirty 2>/dev/null) (dev checkout)"
  else
    out="harness unknown (no VERSION file)"
  fi
  # --verbose: where this engine runs from, and the stable path units reach it through (#281).
  if [[ "${1:-}" == --verbose ]]; then
    out+=$'\n'"engine: $ENGINE_DIR"$'\n'"stable: $HARNESS_ENGINE_LINK"
  fi
  # A reader that stops early (`| head -0`) or standard output closed (`>&-`) must not turn a successful version report
  # into exit 141 or a "write error" on stderr: ignore SIGPIPE for the one write and drop its failure (#993).
  ( trap '' PIPE; printf '%s\n' "$out" ) 2>/dev/null || true
}
# Standard output closed (`>&-`): drop the text quietly and succeed, as the Python subcommands do (#837, #984).
usage(){ ( exec 3>&1 ) 2>/dev/null || return 0
  cat <<EOF
usage: harness <command> [args]
  --version [--verbose]  print this engine's release (or dev checkout) and commit
                       (--verbose: also the engine dir and the stable path units use)
  install              install the engine once to ~/.harness/engine + link 'harness' onto PATH
  init                 interactive setup wizard (writes config, creates labels, seeds repo)
  start [--recover]    launch the worker pool (--recover = crash/new-host sweep first)
  stop  [--clean]      stop the pool (--clean also removes worktrees)
  status [--watch [s]] [--all]  dashboard (outside a project, or --all: every fleet on this host)
  stats [--prd N|--issue N] [-R repo] [--since 7d] [--fleet P] [--model M] [--json] [--backfill]
                       host-wide event log report: sessions, tokens by model, retries, HOLD time
  forecast <issue> [-R repo] [--unit U] [--json]
                       per-phase p50/p80/p95 \$ forecast for one issue, from past lanes in the event log
  tier decide --criteria N --lines N --files N --subsystems N [--prefer direct|lane|fleet] [--json]
  tier overlap --files a,b [-R repo]
                       "When to use Harness" (#619): pick direct / single lane / fleet from an estimate,
                       with a time + cost for direct and fleet; overlap = may a direct fix touch these
                       files, or does an open lane/PR own them (exit 1 -> /harness-issue)
  one check | one gate <issue> [-R repo] [--unit U] [--json]
                       /harness-one: is the fleet PAUSED or usage-HELD; APPROVE/DENY the issue's
                       forecast against live usage (HARNESS_ONE_STOP_PCT) — the human decides
  one start <issue> | one phase <issue> <phase> | one release <issue>
                       /harness-one on approval: claim + render impl.md here; the per-phase
                       budget re-check (CHECKPOINT = the pause --force checkpoint); give it back
  one done <issue>     /harness-one once merged: the reap goal check must say DONE, then the next
                       claimable issue (as dispatch picks it) with a fresh forecast + gate
  doctor [--fix]       diagnose lock wedges + stale pidfiles (--fix clears this project's orphans)
  attach <unit> [issue] tmux-attach to a session
  pause [--force]      pause the fleet (--force = checkpoint each agent to GitHub)
  resume               clear pause; resume here or start --recover (works across machines)
  update [--with-skills] [--rollback]   install the latest release (--rollback: flip back to the previous one)
  release [--dry-run] [--ref <rev>]
                       cut the next Harness release from this checkout (gate: test/run.sh)
  migrate              convert a vendored .harness/ to state-only; re-point at the shared engine
  uninstall [--force] [--force-engine]  stop the fleet + remove the engine, this project's .harness/, and /harness skills (--force-engine: remove the shared engine even if other fleets still depend on it)
  setup                verify prereqs + seed configured labels on all units (no start)
  poll  [--once|--status]  host poller debug entry (the shared snapshot refresher; #71)
  supervise [--once] [--dry-run] | --install | --uninstall
                       host supervisor for every fleet: restart dead workers, clear orphan locks,
                       nudge/checkpoint/kill frozen sessions (--install: systemd user unit; #180)
  web [--install | --uninstall]
                       read-only dashboard of every fleet on this host (http://127.0.0.1:4637/)
                       (--install: systemd user unit; #226)
  plan  "<brief>"      inject a plan/topology change into a live fleet (grill via /harness-plan)
  prd   "<brief>"      extend PRD scope + create delta issues (grill via /harness-prd)
  issue "<brief>"      inject implementation issue(s) into a live fleet (grill via /harness-issue)

global options:
  --state-dir <path>   act on THIS project's .harness/, deliberately — accepted before or after the
                       command, and the only way to target a project you are not standing in. An
                       INHERITED STATE_DIR that disagrees with the .harness/config found from the
                       current directory is REFUSED (#168): a session launched inside one fleet
                       would otherwise stop/pause a different project's fleet, silently.
                       HARNESS_STATE_DIR_OK=1 waives that check for a whole shell.
EOF
}
# vis_arg STR — STR for a human-readable message (#952), spelled as scripts/stats.py `vis` does (#756): a C0 or C1
# control character, DEL, U+2028 and U+2029 become \uXXXX, so an unknown command's name never splits the error over
# several lines or reaches the terminal raw. Byte-level under LC_ALL=C, so no locale matters.
vis_arg(){
  local LC_ALL=C s="$1" out="" i=0 n c d e v
  n=${#s}
  while (( i < n )); do
    c="${s:i:1}"; printf -v v '%d' "'$c"
    if (( v < 32 || v == 127 )); then printf -v c '\\u%04x' "$v"
    elif (( v == 194 && i + 1 < n )); then
      d="${s:i+1:1}"; printf -v e '%d' "'$d"
      if (( e >= 128 && e <= 159 )); then printf -v c '\\u%04x' "$e"; i=$((i+1)); fi
    elif (( v == 226 && i + 2 < n )); then
      d="${s:i+1:2}"
      if [[ "$d" == $'\x80\xa8' ]]; then c='\u2028'; i=$((i+2))
      elif [[ "$d" == $'\x80\xa9' ]]; then c='\u2029'; i=$((i+2)); fi
    fi
    out+="$c"; i=$((i+1))
  done
  printf '%s' "$out"
}
# Global option scan, before dispatch: --state-dir <path> | --state-dir=<path> marks a DELIBERATE
# target, the escape hatch from the inherited-STATE_DIR refusal above (#168). Consumed here, never
# forwarded to the subcommand script. Only an exact token matches, so a quoted brief is untouched.
STATE_DIR_EXPLICIT=0
_argv=()
while (($#)); do
  case "$1" in
    --state-dir)
      shift; [[ $# -gt 0 && -n "$1" ]] || { echo "harness: --state-dir requires a path" >&2; exit 2; }
      # A dash-led value after a space is most likely a forgotten path, as for the other options (#973): say so, and name the = form.
      [[ "$1" != -* ]] || { echo "harness: --state-dir '$(vis_arg "$1")' looks like an option; write --state-dir=$(vis_arg "$1")" >&2; exit 2; }
      STATE_DIR="$1"; STATE_DIR_EXPLICIT=1; export STATE_DIR;;
    --state-dir=*)
      STATE_DIR="${1#--state-dir=}"
      [[ -n "$STATE_DIR" ]] || { echo "harness: --state-dir requires a path" >&2; exit 2; }
      STATE_DIR_EXPLICIT=1; export STATE_DIR;;
    *) _argv+=("$1");;
  esac
  shift
done
set -- ${_argv[@]+"${_argv[@]}"}
# An explicit --state-dir is a DELIBERATE choice of project (#168): a path that is not a directory is a typo, not a project, so it is a
# usage error (#986) rather than being ignored or failing deep in lib.sh. `init` is exempt: it creates the directory.
if (( STATE_DIR_EXPLICIT )) && [[ "${1:-}" != init && ! -d "$STATE_DIR" ]]; then
  if [[ -e "$STATE_DIR" ]]; then _why="not a directory"; else _why="no such directory"; fi
  echo "harness: --state-dir '$(vis_arg "$STATE_DIR")': $_why" >&2; exit 2
fi
# An empty command NAME ("") is a command, not an absent one (#953): only no argument at all prints the usage and exits 0.
_have_cmd=$#
cmd="${1:-}"; shift || true
case "$cmd" in
  # engine-level: no project state needed. install bootstraps the host engine; update installs the latest release
  # (best-effort STATE_DIR so its "pool still running" warning is accurate when run in a project).
  install) exec bash "$ENGINE_DIR/install.sh" "$@";;
  # --version is engine-level too: it reads only ENGINE_DIR, never a project .harness/ (#277).
  --version|version) print_version "$@"; exit 0;;
  update) try_state_dir; exec bash "$ENGINE_DIR/update.sh" "$@";;
  # release is engine-level: it acts on the git checkout it is run in, never a project .harness/ (#278).
  release) exec bash "$ENGINE_DIR/scripts/release.sh" "$@";;
  # poll is HOST-level (the shared poller serves every project) — no project STATE_DIR needed.
  # Normal path is ensure_poller; this is the documented debug/test entry (#71).
  poll)   exec bash "$ENGINE_DIR/scripts/poller.sh" "$@";;
  # stats is HOST-level like poll: the event log ($HARNESS_HOME/events.jsonl) covers every project (#185); the project (best-effort) only supplies HARNESS_TEST_COMMAND_PATTERNS (#379).
  stats)  try_state_dir; exec python3 "$ENGINE_DIR/scripts/stats.py" report "$@";;
  # forecast reads the same host event log; the project (best-effort) only names the issue's unit (#363).
  forecast) try_state_dir; exec python3 "$ENGINE_DIR/scripts/forecast.py" "$@";;
  # tier is HOST-level: an estimate in, a tier out, thresholds from scripts/tier.toml (#619); overlap asks gh/git only.
  tier) try_state_dir; exec python3 "$ENGINE_DIR/scripts/tier.py" "$@";;
  # supervise is HOST-level too: one supervisor walks every fleet on the host (#180).
  supervise) exec bash "$ENGINE_DIR/scripts/supervise.sh" "$@";;
  # web is HOST-level too: the read-only dashboard over every registered fleet (#223).
  web) exec bash "$ENGINE_DIR/scripts/web.sh" "$@";;
  # init CREATES the project state, so it can't discover it: target $PWD/.harness (env override wins).
  init)   STATE_DIR="${STATE_DIR:-$(pwd -P)/.harness}"; export STATE_DIR; exec bash "$ENGINE_DIR/scripts/init.sh" "$@";;
  # project commands: resolve STATE_DIR (pre-set env wins, else upward discovery) or error clearly.
  start)  require_state_dir; exec bash "$ENGINE_DIR/scripts/start.sh" "$@";;
  stop)   require_state_dir; exec bash "$ENGINE_DIR/scripts/stop.sh" "$@";;
  # status outside any project (or --all from anywhere) is the HOST view — every registered fleet,
  # read from $HARNESS_FLEETS_DIR — instead of the not-inside-a-project error (#184). Inside a
  # project it is unchanged; --watch passes through to whichever view runs.
  status)
    if [[ " $* " == *" --all "* ]]; then
      _sa=(); for _x in "$@"; do [[ "$_x" == --all ]] || _sa+=("$_x"); done
      exec python3 "$ENGINE_DIR/scripts/fleetview.py" ${_sa[@]+"${_sa[@]}"}
    fi
    [[ -n "${STATE_DIR:-}" ]] || discover_state_dir >/dev/null || exec python3 "$ENGINE_DIR/scripts/fleetview.py" "$@"
    require_state_dir; exec bash "$ENGINE_DIR/scripts/status.sh" "$@";;
  # one is a project command: the precondition reads this fleet's pause flag and usage holds (#365).
  one)    require_state_dir; exec bash "$ENGINE_DIR/scripts/one.sh" "$@";;
  doctor) require_state_dir; exec bash "$ENGINE_DIR/scripts/doctor.sh" "$@";;
  attach) require_state_dir; exec bash "$ENGINE_DIR/scripts/attach.sh" "$@";;
  pause)  require_state_dir; exec bash "$ENGINE_DIR/scripts/pause.sh" "$@";;
  setup)  require_state_dir; exec bash "$ENGINE_DIR/scripts/setup.sh" "$@";;
  # migrate operates on a specific project's vendored .harness/ — discover which one (config still
  # present in a vendored layout), then strip its engine clone and re-point at the shared engine.
  migrate) require_state_dir; exec bash "$ENGINE_DIR/scripts/migrate.sh" "$@";;
  # uninstall tears down host engine + this project + skills; best-effort STATE_DIR so it also runs
  # outside a project (engine/skills only) and so the default path can stop the discovered fleet.
  # (guarded like the project commands: it DELETES a project's .harness/, so an inherited STATE_DIR
  # pointing at another project is the worst possible silent target — #168.)
  uninstall) try_state_dir; assert_state_dir_deliberate; exec bash "$ENGINE_DIR/scripts/uninstall.sh" "$@";;
  plan|prd|issue) require_state_dir; exec bash "$ENGINE_DIR/scripts/inject.sh" "$cmd" "$@";;
  resume) require_state_dir; exec bash "$ENGINE_DIR/scripts/resume.sh" "$@";;
  help|-h|--help) usage;;
  "") if (( _have_cmd )); then echo "harness: unknown command ''" >&2; usage >&2; exit 2; else usage; fi;;
  *) echo "harness: unknown command '$(vis_arg "$cmd")'" >&2; usage >&2; exit 2;;
esac
