# #488 on winsma, inside C:\hx-488 (cwd = $HX_DIR; HARNESS_HOME, HARNESS_BIN_DIR, CLAUDE_CONFIG_DIR, GH_TOKEN env are the isolation's).
REPO=VocanicZ/harness-smoke-claude
say(){ echo "[$(date -u +%H:%M:%S)] $*"; }
say "== host: $(uname -srm) | bash $BASH_VERSION | python3 $(python3 --version 2>&1)"
say "== 1. clone the branch under test"
git clone -q --branch issue/488 https://github.com/VocanicZ/Harness.git src || { say "clone failed"; exit 1; }
say "src at $(git -C src rev-parse --short HEAD)"

say "== 2. a local release of THIS tree, served over file:// (install.sh installs a release)"
tag=v0.0.0-i488; st="stage/harness-$tag"; mkdir -p "$st" "rel/download/$tag"
( cd src && tar -cf - bin scripts prompts skill plugins install.sh update.sh ) | tar -xf - -C "$st"
printf '%s\n%040d\n' "$tag" 0 > "$st/VERSION"
printf '#!/usr/bin/env bash\necho %s\n' "$tag" > "$st/scripts/release-marker.sh"
tar -C stage -czf "rel/download/$tag/harness-$tag.tar.gz" "harness-$tag"
( cd "rel/download/$tag" && sha256sum "harness-$tag.tar.gz" > SHA256SUMS )

say "== 3. winget is a logging stub: no real 'winget install' runs on winsma"
mkdir -p stubs
printf '#!/usr/bin/env bash\necho "winget $*" >> "%s/winget.log"\nexit 0\n' "$HX_DIR" > stubs/winget
chmod +x stubs/winget
: > winget.log

say "== 4. bash install.sh (HARNESS_INSTALL_PREREQS=1, HARNESS_WINGET=stub, HARNESS_REF=$tag)"
export HARNESS_BASE_URL="file:///$HX_DIR/rel/download" HARNESS_REF="$tag" HARNESS_WINGET="$HX_DIR/stubs/winget" HARNESS_INSTALL_PREREQS=1 HARNESS_INSTALL_NOPROMPT=1
export HARNESS_SKIP_RTDD=1
bash src/install.sh </dev/null 2>&1 | sed 's/^/   /'; irc=${PIPESTATUS[0]}
say "install.sh exit $irc"
say "winget stub calls: $(wc -l < winget.log) -> $(cat winget.log | tr '\n' ';')"
[[ -x "$HARNESS_HOME/bin/python3" ]] && say "python3 shim present"
ls "$HARNESS_BIN_DIR" | sed 's/^/   bin: /'
(( irc == 0 )) || { say "INSTALL FAILED"; exit 1; }

export PATH="$(cygpath -u "$HARNESS_BIN_DIR"):$PATH"   # a C:/… entry cannot sit in an MSYS PATH
H=harness; say "harness resolves to: $(command -v harness)"
say "== 5. harness --version: $($H --version 2>&1 | head -1)"

say "== 6. harness init in a fresh clone of the sandbox"
git clone -q "https://github.com/$REPO.git" clone || { say "sandbox clone failed"; exit 1; }
cd clone || exit 1
( HARNESS_INIT_NONINTERACTIVE=1 HARNESS_SESSION_BACKEND=headless HARNESS_CLI=claude HARNESS_MODE=issue-only \
  HARNESS_OWNER=VocanicZ HARNESS_REPO="$REPO" HARNESS_SESS_PREFIX=hxi488 HARNESS_POOL=1 HARNESS_POLL=30 HARNESS_PRIORITY_POLL=60 \
  HARNESS_USE_POLLER=0 HARNESS_AUTONOMOUS=true $H init </dev/null ) 2>&1 | sed 's/^/   /'
[[ -f .harness/config ]] || { say "harness init wrote no config"; exit 1; }
printf ': "${HARNESS_SWARM:=off}"\n' >> .harness/config

say "== 7. issue + harness start (sandbox CLAUDE_CONFIG_DIR, no sign-in)"
PRD="$(gh issue create -R "$REPO" -l prd -t "i488 winsma PRD" -b "Tracking issue for #488's winsma run. Closed by cleanup." | grep -oE '[0-9]+$')"
ISS="$(gh issue create -R "$REPO" -l ready-for-agent -t "i488 winsma: dispatch check" -b "$(printf 'Dispatch check for Harness #488. The fleet only needs to claim this; the run has no Claude sign-in. Closed by cleanup.\n\n## Parent\n#%s\n' "$PRD")" | grep -oE '[0-9]+$')"
say "filed PRD #$PRD and issue #$ISS"
cleanup_issues(){ gh issue close "$ISS" -R "$REPO" -c "i488 winsma run over" >/dev/null 2>&1; gh issue close "$PRD" -R "$REPO" -c "i488 winsma run over" >/dev/null 2>&1
  gh issue edit "$ISS" -R "$REPO" --remove-label agent-working >/dev/null 2>&1; }
trap cleanup_issues EXIT
$H start 2>&1 | sed 's/^/   /'
dispatched=0
for i in $(seq 1 20); do
  sleep 15
  labels="$(gh issue view "$ISS" -R "$REPO" --json labels --jq '[.labels[].name]|sort|join(",")' 2>/dev/null)"
  say "poll $i: issue #$ISS labels=$labels"
  [[ ",$labels," == *,agent-working,* ]] && { dispatched=1; break; }
  gone="$(gh issue list -R "$REPO" -l agent-working --json number,title -q '.[]|select(.title|startswith("i488"))|.number' 2>/dev/null | head -1)"
  [[ -n "$gone" ]] && { ISS="$gone"; say "claimed #$ISS (agent-working)"; dispatched=1; break; }
done
(( dispatched )) && say "DISPATCHED: #$ISS claimed (agent-working)" || say "NOT DISPATCHED within 5 minutes"
sleep 20
say "== 8. the lane's worktree got per-repo git settings"
git -C . worktree list | sed 's/^/   /'
for k in core.longpaths core.autocrlf core.eol; do say "$k = $(git -C . config --local --get $k)"; done
wt="$(ls -d .harness/worktrees/* 2>/dev/null | head -1)"
[[ -n "$wt" ]] && for k in core.longpaths core.autocrlf core.eol; do say "worktree $wt: $k = $(git -C "$wt" config --get $k)"; done
say "global core.longpaths = '$(git config --global --get core.longpaths)' (must be empty)"

say "== 9. harness doctor"
$H doctor 2>&1 | sed 's/^/   /'; say "doctor exit ${PIPESTATUS[0]}"

say "== 10. harness stop --clean"
$H stop --clean 2>&1 | sed 's/^/   /'
cleanup_issues; trap - EXIT
(( dispatched )) || exit 1
exit 0
