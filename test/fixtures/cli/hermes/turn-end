#!/usr/bin/env bash
# turn-end <wd> <session id> [reply] — one prompt's turn ending as Hermes records it in the lane
# profile's state.db (transcript.db's shapes): a user message, then the assistant message that ends
# the turn (finish_reason `stop`) holding [reply]. With no session id yet, it is the session the launch
# titled (the state file's session_id), created as `--create-if-missing` creates it on the first
# turn. The pane is then idle at its prompt (idle.txt), which is when the Harness-driven goal loop
# reads the reply.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/../../../../scripts/cli/hermes.sh"   # the lane's state.db: _hermes_db
db="$(_hermes_db "$1")"; mkdir -p "${db%/*}"; [[ -f $db ]] || cp "$here/transcript.db" "$db"
python3 - "$db" "${2:-}" "$(sed -n 's/^session_id: //p' "$1/.claude/ralph-loop.local.md" 2>/dev/null)" "${3:-(working)}" <<'PY'
import sqlite3, sys, time
db, sid, title, reply = sys.argv[1:]
c = sqlite3.connect(db)
if not sid:
    r = c.execute("SELECT id FROM sessions WHERE title = ? AND parent_session_id IS NULL", (title,)).fetchone()
    if r:
        sid = r[0]
    else:
        sid = "local-" + format(int(time.time() * 1e6), "x")
        c.execute("INSERT INTO sessions (id, source, title, model, started_at) VALUES (?, 'local', ?, 'gpt-4.1', ?)", (sid, title, time.time()))
now = time.time()
c.execute("INSERT INTO messages (session_id, role, content, timestamp, active) VALUES (?, 'user', 'Read .harness-task.md in this directory and follow it exactly.', ?, 1)", (sid, now))
c.execute("INSERT INTO messages (session_id, role, content, timestamp, finish_reason, active) VALUES (?, 'assistant', ?, ?, 'stop', 1)", (sid, reply, now + 1))
c.commit()
PY
