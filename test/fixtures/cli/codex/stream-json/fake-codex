#!/usr/bin/env python3
"""fake-codex — stands in for `codex exec --json` (README.md): each run replays one captured turn from this
directory, in the order $FAKE_CLAUDE_DIR/plan names them (one fixture name per line: normal, tool-use, limit,
transient, no-conversation — or `hang`, a turn that never ends). Text after the name on a plan line
(`normal <promise>X</promise>`) replaces the turn's reply (the agent_message's text).

Per run it appends {argv, prompt (its stdin), pid} to $FAKE_CLAUDE_DIR/calls.jsonl, then prints the fixture's
events with every thread_id set to the one the argv resumes (`codex exec resume … <id> -`) or, for a new
thread, one made up from the fake's dir (the same thread for every turn that resumes it). While
$FAKE_CLAUDE_DIR/hold exists it waits after the first event, so a test can act mid-turn. `hang` prints
thread.started, starts a grandchild (`sleep`), writes `<own pid> <grandchild pid>` to $FAKE_CLAUDE_DIR/pids
and waits forever. It exits 1 after a failed turn, as codex does. `no-conversation` prints nothing to
stdout and the fixture's stderr line: codex has no event for a thread it cannot resume. An executable
$FAKE_CLAUDE_DIR/turn-hook runs first with the prompt on its stdin, in codex's working directory.

With $CODEX_HOME set, a turn that completes also appends what codex writes to its rollout under
$CODEX_HOME/sessions (the real run's: token-count.jsonl): session_meta once, then a turn_context and a
token_count whose rate_limits windows reset an hour and a day from now (a passed reset is skipped)."""
import datetime, json, os, re, subprocess, sys, time, uuid

here = os.path.dirname(os.path.abspath(__file__))
d = os.environ["FAKE_CLAUDE_DIR"]
argv = sys.argv[1:]
resumed = None
if "resume" in argv[:2]:
    ids = [a for a in argv[argv.index("resume") + 1:-1] if len(a) == 36 and a.count("-") == 4]
    resumed = ids[-1] if ids else None
model = next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a in ("-m", "--model")), "gpt-5.6-luna")
prompt = sys.stdin.read()
with open(os.path.join(d, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"argv": argv, "prompt": prompt, "pid": os.getpid()}) + "\n")
n = sum(1 for _ in open(os.path.join(d, "calls.jsonl")))
hook = os.path.join(d, "turn-hook")
if os.access(hook, os.X_OK):
    subprocess.run([hook], input=prompt, text=True)
plan = [l.strip() for l in open(os.path.join(d, "plan")) if l.strip()]
name, _, reply = (plan[n - 1] if n <= len(plan) else "normal").partition(" ")
tid = resumed or str(uuid.uuid5(uuid.NAMESPACE_URL, d))

if name == "no-conversation":
    sys.stderr.write(open(os.path.join(here, "no-conversation.stderr")).read())
    sys.exit(1)
src = "normal" if name == "hang" else name
events = [json.loads(l) for l in open(os.path.join(here, f"{src}.jsonl")) if l.strip()]
for e in events:
    if "thread_id" in e:
        e["thread_id"] = tid
    if reply and e.get("type") == "item.completed" and (e.get("item") or {}).get("type") == "agent_message":
        e["item"]["text"] = reply
if name == "hang":
    events = events[:1]
# the limit fixture says "try again at Nov 18th, 2026 3:21 PM": move that to an hour from now, in the same shape
later = time.localtime(time.time() + 3600)
day = later.tm_mday
nth = f"{day}{'th' if 10 <= day % 100 <= 20 else {1: 'st', 2: 'nd', 3: 'rd'}.get(day % 10, 'th')}"
again = time.strftime(f"%b {nth}, %Y ", later) + time.strftime("%I:%M %p", later).lstrip("0")
for e in events:
    for holder in (e, e.get("error") or {}):
        if isinstance(holder.get("message"), str):
            holder["message"] = re.sub(r"try again at [^.]*\.", f"try again at {again}.", holder["message"])


def rollout():
    home = os.environ.get("CODEX_HOME")
    if not home:
        return
    now = datetime.datetime.now(datetime.timezone.utc)
    day = os.path.join(home, "sessions", now.strftime("%Y"), now.strftime("%m"), now.strftime("%d"))
    os.makedirs(day, exist_ok=True)
    files = [f for f in os.listdir(day) if f.endswith(f"-{tid}.jsonl")]
    path = os.path.join(day, files[0] if files else f"rollout-{now.strftime('%Y-%m-%dT%H-%M-%S')}-{tid}.jsonl")
    rows = []
    if not files:
        rows.append({"timestamp": now.isoformat(), "type": "session_meta", "payload": {
            "session_id": tid, "id": tid, "timestamp": now.isoformat(), "cwd": os.getcwd(),
            "originator": "codex_exec", "source": "exec"}})
    rows.append({"timestamp": now.isoformat(), "type": "turn_context", "payload": {"cwd": os.getcwd(), "model": model}})
    seen = sum(1 for l in open(path) if '"token_count"' in l) if files else 0
    tc = [json.loads(l) for l in open(os.path.join(here, "token-count.jsonl")) if l.strip()]
    row = tc[min(seen, len(tc) - 1)]
    rl = row["payload"]["rate_limits"]
    for key, secs in (("primary", 3600), ("secondary", 86400)):
        if rl.get(key):
            rl[key]["resets_at"] = int(time.time()) + secs
    row["timestamp"] = now.isoformat()
    rows.append(row)
    with open(path, "a") as f:
        f.write("".join(json.dumps(r) + "\n" for r in rows))


failed = False
for i, e in enumerate(events):
    print(json.dumps(e, separators=(",", ":")), flush=True)
    failed = failed or e.get("type") == "turn.failed"
    if e.get("type") == "turn.completed":
        rollout()
    if i == 0:
        while os.path.exists(os.path.join(d, "hold")):
            time.sleep(0.05)
if name == "hang":
    child = subprocess.Popen(["sleep", "600"])
    with open(os.path.join(d, "pids"), "w") as f:
        f.write(f"{os.getpid()} {child.pid}\n")
    while True:
        time.sleep(1)
sys.exit(1 if failed else 0)
