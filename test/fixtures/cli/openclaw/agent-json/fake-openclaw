#!/usr/bin/env python3
"""fake-openclaw — stands in for `openclaw` in `test/test_openclaw_headless.py` and the matrix's `headless-*` rows
(`test/test_cli_matrix.sh`, #485): `openclaw agent exec --json --message-file -` replays one captured turn from this
directory (../README.md, "agent-json"), in the order $FAKE_CLAUDE_DIR/plan names them (one fixture name per line:
normal, tool-use, limit, transient — or `hang`, a turn that never ends). The variable keeps claude's name because the
matrix's headless-* rows are shared by every CLI. Text after the name on a plan line (`normal <promise>X</promise>`)
replaces the turn's reply (the envelope's `final` and its payload's text).

Per `agent exec` run it appends {argv, prompt (its stdin), pid, cwd, include_roots} to $FAKE_CLAUDE_DIR/calls.jsonl, then
prints the fixture's envelope, pretty-printed as OpenClaw prints it, with a new `sessionId` (every turn is its own
session): the whole document at the end of the turn, nothing before it. It exits 1 after an envelope whose `ok` is false,
as OpenClaw does. `status --usage --json` prints ../usage-windows.json with its resets an hour ahead (ms; a passed reset
is skipped). While $FAKE_CLAUDE_DIR/hold exists a run waits before printing, so a test can act mid-turn. `hang` starts a
grandchild (`sleep`), writes `<own pid> <grandchild pid>` to $FAKE_CLAUDE_DIR/pids and waits forever. An executable
$FAKE_CLAUDE_DIR/turn-hook runs first with the prompt on its stdin, in the working directory — the commands an agent
would run in that turn (#350: a checkpoint's gh calls)."""
import json, os, subprocess, sys, time, uuid

here = os.path.dirname(os.path.abspath(__file__))
argv = sys.argv[1:]


def sibling(name):
    """A file the matrix copies beside this one, or the fixtures dir above it."""
    own = os.path.join(here, name)
    return own if os.path.exists(own) else os.path.join(here, "..", name)


if argv[:3] == ["status", "--usage", "--json"]:
    d = json.load(open(sibling("usage-windows.json")))
    for p in (d.get("usage") or {}).get("providers") or []:
        for w in p.get("windows") or []:
            w["resetAt"] = int((time.time() + 3600) * 1000)
    print(json.dumps(d))
    sys.exit(0)
if argv[:2] != ["agent", "exec"]:
    sys.stderr.write(f"fake-openclaw: unsupported command {argv}\n")
    sys.exit(2)

d = os.environ["FAKE_CLAUDE_DIR"]
prompt = sys.stdin.read()
with open(os.path.join(d, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"argv": argv, "prompt": prompt, "pid": os.getpid(), "cwd": os.getcwd(),
                        "include_roots": os.environ.get("OPENCLAW_INCLUDE_ROOTS")}) + "\n")
n = sum(1 for _ in open(os.path.join(d, "calls.jsonl")))
hook = os.path.join(d, "turn-hook")
if os.access(hook, os.X_OK):
    subprocess.run([hook], input=prompt, text=True)
plan = [l.strip() for l in open(os.path.join(d, "plan")) if l.strip()]
name, _, reply = (plan[n - 1] if n <= len(plan) else "normal").partition(" ")

while os.path.exists(os.path.join(d, "hold")):
    time.sleep(0.05)
if name == "hang":
    child = subprocess.Popen(["sleep", "600"])
    with open(os.path.join(d, "pids"), "w") as f:
        f.write(f"{os.getpid()} {child.pid}\n")
    while True:
        time.sleep(1)

src = {"tool-use": "tool-use"}.get(name, name)
env = json.load(open(os.path.join(here, f"{src}.json")))
env["sessionId"] = str(uuid.uuid4())
if reply and env.get("ok"):
    env["final"] = reply
    for p in env.get("payloads") or []:
        p["text"] = reply
print(json.dumps(env, indent=2, ensure_ascii=False), flush=True)
sys.exit(0 if env.get("ok") else 1)
